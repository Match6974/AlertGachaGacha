{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alertgachagacha-scheduler",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
